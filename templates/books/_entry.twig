{% extends "_layouts/base" %}
{% set title = entry.title %}

{% block content %}
    <article class="book-detail">
        {% if entry.coverImage.one() %}
            <img src="{{ entry.coverImage.one().url }}" alt="{{ entry.title }}">
        {% endif %}
        <div>
            <h1>{{ entry.title }}</h1>
            <p class="author">by {{ entry.author }}</p>
            <p class="isbn">ISBN: {{ entry.isbn }}</p>
            <p class="genre">Genre: {{ entry.genre.label }}</p>
            <p class="availability {{ entry.available ? 'available' : 'checked-out' }}">
                {{ entry.available ? 'Available for checkout' : 'Currently checked out' }}
            </p>
            <div class="summary">{{ entry.summary|nl2br }}</div>
        </div>
    </article>
{% endblock %}
