{% extends "_layouts/base" %}
{% set title = entry.title %}

{% block content %}
    <article class="staff-detail">
        {% if entry.photo.one() %}
            <img src="{{ entry.photo.one().url }}" alt="{{ entry.title }}">
        {% endif %}
        <h1>{{ entry.title }}</h1>
        <p class="job-title">{{ entry.jobTitle }}</p>
        <p class="department">{{ entry.department.label }}</p>
    </article>
{% endblock %}
